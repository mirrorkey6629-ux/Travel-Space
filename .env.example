# API
API_HOST=0.0.0.0
API_PORT=3000

# Базовый путь приложения. Для клиента он вшивается в бандл на этапе сборки
# (build-arg BASE_PATH), поэтому в образе менять его нельзя — только пересобрав.
BASE_PATH=/travel

# Публичный origin для ссылок-приглашений. Используется, когда в запросе нет
# заголовка Origin; из него же складывается адрес вида <origin>/travel/join/<token>.
PUBLIC_ORIGIN=http://127.0.0.1:4173

DATABASE_URL=postgres://travel:travel@127.0.0.1:5432/travel
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=15728640
MAX_IMPORT_BYTES=209715200
SESSION_TTL_DAYS=30
NODE_ENV=development

# Ограниченный браузерный ключ Google Maps JavaScript API. Нужен для выбора
# точки кликом по карте; ограничьте ключ доменом приложения в Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Идентификатор карты из Google Cloud Console. Нужен для маркеров
# AdvancedMarkerElement и облачной стилизации карты.
VITE_GOOGLE_MAPS_MAP_ID=

# Каталог собранного SPA. По умолчанию вычисляется относительно кода и указывает
# на dist в корне репозитория; задавать вручную нужно лишь при нестандартной
# раскладке. Если каталога нет, приложение работает как чистый API, а статику
# отдаёт vite dev server.
# SPA_DIST_DIR=

# Аварийный выключатель: поднять сервер, не применяя миграции при старте.
# TRAVEL_SKIP_MIGRATIONS=false
